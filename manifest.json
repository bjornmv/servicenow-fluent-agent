{
  "name": "ServiceNow Fluent Agent",
  "packageName": "servicenow-fluent-agent",
  "version": "0.1.0",
  "description": "VS Code custom agent, instructions, and skills for ServiceNow now-sdk / Fluent development.",
  "payloadRoot": "payload",
  "installRoots": [
    ".copilot/agents",
    ".agents/instructions",
    ".agents/reference",
    ".agents/skills",
    ".agents/tools"
  ],
  "vscodeSettings": {
    "chat.promptFiles": true,
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    "chat.agentFilesLocations": ["~/.copilot/agents"],
    "chat.instructionsFilesLocations": ["~/.agents/instructions", ".github/instructions"],
    "chat.skillsFilesLocations": ["~/.agents/skills"]
  }
}
