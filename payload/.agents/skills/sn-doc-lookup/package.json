{
  "name": "sn-doc-md",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown-native ServiceNow documentation index/search CLI for ServiceNowDocs GitHub corpus.",
  "type": "commonjs",
  "bin": {
    "sn-doc-md": "bin/sn-doc-md.js"
  },
  "scripts": {
    "paths": "node bin/sn-doc-md.js paths",
    "build:index": "node bin/sn-doc-md.js build --family australia",
    "test:quality": "node test/run-tests.js",
    "search": "node bin/sn-doc-md.js search"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {}
}
